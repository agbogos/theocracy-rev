# ── Game distribution: binaries & assets ──────────────────────────────────
# The original Theocracy binaries and data are copyrighted and NOT
# redistributable. They must be provided out-of-band, not committed.
#   /linux/    -> theocracy.real, libmvos*.so, server, ... (game dist)
#   /data/cd   -> ~448M ripped CD assets
#   /data/game -> ~184M extracted/decrypted game data
# Kept on purpose: /data/*.tsv and /data/mvos_api.json (small derived symbol/
# reloc reference tables the docs depend on; no copyrighted content).
/linux/
/data/cd/
# Ignore the extracted game data, but keep our hand-authored mvos.cfg (normally
# installed by inst.linux; the libmvos cfg loader reads it as data/game/mvos.cfg).
/data/game/*
!/data/game/mvos.cfg

# ── Build artifacts ───────────────────────────────────────────────────────
/port/build/
build/
*.o
*.obj
*.a
*.dylib

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Editor / OS / local ───────────────────────────────────────────────────
.DS_Store
.claude/settings.local.json
